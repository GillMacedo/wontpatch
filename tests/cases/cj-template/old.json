{
  "apiVersion": "batch/v1",
  "kind": "CronJob",
  "metadata": {
    "name": "cj"
  },
  "spec": {
    "schedule": "* * * * *",
    "jobTemplate": {
      "spec": {
        "template": {
          "spec": {
            "restartPolicy": "Never",
            "containers": [
              {
                "name": "c",
                "image": "nginx:1.27"
              }
            ]
          }
        }
      }
    }
  }
}
