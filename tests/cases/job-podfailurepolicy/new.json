{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "migrate"
  },
  "spec": {
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "c",
            "image": "nginx:1.27"
          }
        ]
      }
    },
    "podFailurePolicy": {
      "rules": [
        {
          "action": "FailJob",
          "onExitCodes": {
            "operator": "In",
            "values": [
              42
            ]
          }
        }
      ]
    }
  }
}
