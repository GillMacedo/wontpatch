{
  "apiVersion": "v1",
  "kind": "PersistentVolume",
  "metadata": {
    "name": "{{name}}"
  },
  "spec": {
    "capacity": {
      "storage": "1Gi"
    },
    "accessModes": [
      "ReadWriteOnce"
    ],
    "hostPath": {
      "path": "/tmp/a"
    },
    "nodeAffinity": {
      "required": {
        "nodeSelectorTerms": [
          {
            "matchExpressions": [
              {
                "key": "k",
                "operator": "In",
                "values": [
                  "v"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
