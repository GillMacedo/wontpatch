{
  "apiVersion": "apps/v1",
  "kind": "ReplicaSet",
  "metadata": {
    "name": "rs"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app": "r",
        "v": "1"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "r",
          "v": "1"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "c",
            "image": "nginx:1.27"
          }
        ]
      }
    }
  }
}
