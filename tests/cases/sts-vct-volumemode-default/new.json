{
  "apiVersion": "apps/v1",
  "kind": "StatefulSet",
  "metadata": {
    "name": "db"
  },
  "spec": {
    "serviceName": "db",
    "selector": {
      "matchLabels": {
        "app": "db"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "db"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "c",
            "image": "nginx:1.27"
          }
        ]
      }
    },
    "volumeClaimTemplates": [
      {
        "metadata": {
          "name": "data"
        },
        "spec": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "1Gi"
            }
          },
          "volumeMode": "Filesystem"
        }
      }
    ]
  }
}
